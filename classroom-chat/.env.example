# 复制为 .env 后填写自己的密钥。
# .env 已被 .gitignore 排除，不会提交到仓库。

# --- 模型（必需）---------------------------------------------------------
# 从 n8n 的 "DeepSeek account" 凭据迁移过来，密钥只在本地 Node 进程内读取，
# 不会发送到浏览器。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.4
# 需要走代理或自建网关时才填，留空则用官方地址
DEEPSEEK_BASE_URL=

# --- 高级语音（可选）------------------------------------------------------
# 不配置时自动回退到浏览器内置语音。
TTS_PROVIDER=qwen
TTS_QWEN_API_KEY=sk-your-dashscope-api-key
TTS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_QWEN_MODEL=qwen3-tts-flash
TTS_QWEN_VOICE=Cherry
TTS_QWEN_SPEED=1.0

# --- 服务（可选）----------------------------------------------------------
# CLASSROOM_CHAT_HOST=127.0.0.1
# CLASSROOM_CHAT_PORT=4173

# --- 阶段 0 遗留兼容（迁移完成后可删除）-----------------------------------
# 以下变量只在回退到旧 n8n 工作流时才需要，LangGraph 版本不再使用。
# N8N_CHAT_WEBHOOK=http://localhost:5678/webhook/24c2ba65-8779-45a1-86d8-8c6ab4f824eb/chat
