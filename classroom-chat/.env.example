# 这是模板文件，会被提交到仓库 —— 只放占位符，不要填真实密钥。
#
# 用法：复制为 .env，然后在 .env 里填真实值。
#   cp .env.example .env
# .env 已被 .gitignore 排除，不会提交。

# --- 模型（必需）---------------------------------------------------------
# 从 n8n 的 "DeepSeek account" 凭据迁移过来，密钥只在本地 Node 进程内读取，
# 不会发送到浏览器。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
# 控制回答的随机性：0 = 几乎固定，0.4 = 稳定但有措辞变化，1.0+ = 发散。
# 这个项目要求模型返回严格 JSON，值太高容易把格式写坏。
DEEPSEEK_TEMPERATURE=0.4
# 需要走代理或自建网关时才填，留空则用官方地址
DEEPSEEK_BASE_URL=

# --- 高级语音（可选）------------------------------------------------------
# 不配置时自动回退到浏览器内置语音。
TTS_PROVIDER=qwen
TTS_QWEN_API_KEY=sk-your-dashscope-api-key
TTS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_QWEN_MODEL=qwen3-tts-flash
TTS_QWEN_VOICE=Cherry
TTS_QWEN_SPEED=1.0

# --- 服务（可选）----------------------------------------------------------
# CLASSROOM_CHAT_HOST=127.0.0.1
# CLASSROOM_CHAT_PORT=4173
